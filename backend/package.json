{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run --env-file ../.env uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:local": "uv run uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run --env-file ../.env uvicorn main:app --host 0.0.0.0 --port 8000", 
    "start:local": "uv run uvicorn main:app --host 0.0.0.0 --port 8000",
    "test": "uv run --env-file ../.env pytest",
    "test:local": "uv run pytest",
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check . --fix",
    "format": "uv run ruff format .",
    "typecheck": "uv run mypy .",
    "config:check": "uv run --env-file ../.env python -c \"from app.core.config import get_settings; s=get_settings(); print(f'✅ Config loaded: {s.PROJECT_NAME} v{s.VERSION}')\"",
    "build": "echo 'Python backend - no build step required'"
  }
}