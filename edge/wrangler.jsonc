/**
 * Lemma Edge API - Cloudflare Workers Configuration
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lemma-edge",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"placement": { "mode": "smart" },
	
	// Environment Variables (non-sensitive)
	"vars": {
		"SUPABASE_URL": "https://hvbzrbfevhnytecmwbdw.supabase.co",
		"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh2YnpyYmZldmhueXRlY213YmR3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgwNzUwODgsImV4cCI6MjA3MzY1MTA4OH0.8R2l6eSbHujd5CKO1xKh00JuCKGX8PeBBP2VOGKkOAM",
		"BACKEND_URL": "http://localhost:8000",
		"JWT_ALGORITHM": "ES256",
		"JWT_DISCOVERY_URL": "https://hvbzrbfevhnytecmwbdw.supabase.co/auth/v1/.well-known/jwks.json",
		"R2_ACCOUNT_ID": "b49337c8c317194c858bde1373b9aac3"
	},

	// R2 Object Storage Binding
	"r2_buckets": [
		{
			"binding": "DOCUMENTS_BUCKET",
			"bucket_name": "lemma-documents"
		}
	],

	// KV Storage Bindings
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "rate_limit_namespace",
			"preview_id": "rate_limit_namespace_preview"
		}
	],

	// Development Environment
	"env": {
		"development": {
			"name": "lemma-edge-dev",
			"vars": {
				"BACKEND_URL": "http://localhost:8000"
			}
		},
		"staging": {
			"name": "lemma-edge-staging"
		},
		"production": {
			"name": "lemma-edge-prod",
			"vars": {
				"BACKEND_URL": "http://localhost:8000"
			}
		}
	}

	// Note: Use secrets for sensitive data like service keys:
	// wrangler secret put R2_ACCESS_KEY_ID
	// wrangler secret put R2_SECRET_ACCESS_KEY
	// wrangler secret put OPENAI_API_KEY
}