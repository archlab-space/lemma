# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJ...
SUPABASE_SERVICE_KEY=eyJhbGciOiJ...

# Direct PostgreSQL Connection (for asyncpg)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxx:[YOUR_PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# LLM API Configuration
OPENAI_API_KEY=sk-...

# Backend Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Google Cloud Configuration (for production)
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Development Configuration
NODE_ENV=development
PYTHON_ENV=development